{
  "manifest_version": 3,
  "name": "PolyPeek – Triangle Count & AI Filter for Sketchfab",
  "short_name": "PolyPeek",
  "version": "1.4.0",
  "description": "See triangle counts on every Sketchfab model, sort search by tris, and spot or hide AI-generated models.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://sketchfab.com/*"],
      "js": ["search-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://sketchfab.com/*"],
      "js": ["content.js", "search-ui.js"],
      "run_at": "document_idle"
    }
  ]
}
